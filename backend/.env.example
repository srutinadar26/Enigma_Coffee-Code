# Server
PORT=4000
NODE_ENV=development

# Auth
JWT_SECRET=change_this_to_a_long_random_secret_in_production
JWT_EXPIRES_IN=7d

# Field-level encryption (32 bytes -> 64 hex chars). Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=a74c3f620ebce6bb84b58b258877cf982f2289a49169942f7575bf26374773bb

# Optional: enable real LLM-backed AI Assistant. If omitted, an offline
# TF-IDF based assistant is used automatically so the app always works.
ANTHROPIC_API_KEY=

# CORS
FRONTEND_ORIGIN=http://localhost:5173
